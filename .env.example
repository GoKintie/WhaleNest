# 鲸鱼窝环境变量模板
# 复制为 .env 再填值。注意：settings.json 的优先级高于 .env，
# 想让某个参数永久生效，最稳的是在 WebUI 里改（会落盘 settings.json）。

# ---------- 模型渠道 ----------
# 二选一即可；两个都填时按 LLM_PROVIDER / model 前缀决定走哪条。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# 填写该 API Key 所在项目可用的模型 ID。
GEMINI_MODEL=

LLM_PROVIDER=deepseek
DSH_MODEL=deepseek-chat
BOT_NAME=小鲸鱼

# 容器内需要出海时填 HTTP 代理；Node 原生 fetch 不认 HTTPS_PROXY，这里走 undici
API_PROXY=

# Agent 工具循环
AGENT_TOOLS=true
AGENT_MAX_STEPS=8
TEMPERATURE=0.78
MAX_REPLY_TOKENS=1600

# ---------- OneBot v11（NapCat WS）----------
ONEBOT_WS=ws://napcat:3001
NAPCAT_NETWORK=napcat
ONEBOT_TOKEN=

# ---------- 准入与白名单 ----------
ALLOW_USERS=
OWNER_USERS=
ALLOW_GROUPS=
ALLOW_ANYONE=false
AT_ONLY=true

# ---------- 防抖合流 ----------
DEBOUNCE_MS=4000
DEBOUNCE_MAX_MS=15000
DEBOUNCE_SMART=true

# ---------- 群聊插话 ----------
# PROB=0 表示彻底不主动插话（v3 已修掉概率地板，0 就是 0）
GROUP_CHIME_IN=true
GROUP_CHIME_IN_COOLDOWN_MIN=6
GROUP_CHIME_IN_PROB=0.35

# ---------- 回执与分条 ----------
ACK_DELAY_MS=45000
ACK_ONLY_TASK=true
ACK_TEXT=收到，我在弄了，稍等。
REPLY_CHUNK=120
CHUNK_GAP_MS=700

# ---------- 记忆与上下文 ----------
CONTEXT_MESSAGES=120
CONTEXT_CHARS=40000
LIVING_MEMORY=true
SESSION_MAX_TURNS=12

# ---------- 并发 ----------
# 不同会话最多同时跑几条任务；单会话内部永远串行
MAX_CONCURRENT_TASKS=3
MAX_LANE_QUEUE=4

# ---------- WebUI ----------
WEB_PORT=3081
WEB_BIND=127.0.0.1
# 填自己的固定密码后会一直沿用；留空或示例值则生成并持久保存令牌
WEB_TOKEN=change-me-to-a-random-string

# ---------- 路径（Docker 内部通常不用改）----------
WORKDIR=/workspace
INBOX_DIR=/workspace/inbox
MEMORY_DIR=/workspace/memory
SETTINGS_FILE=/workspace/settings.json
SESSIONS_FILE=/workspace/sessions.json
AGENT_SESSIONS_FILE=/workspace/sessions-agent.json

# 仅全新镜像构建使用；不要用旧 DSH_IMAGE 覆盖已有回滚镜像
QQ_AGENT_IMAGE=dsh-qq-agent:3.6.1-r2
