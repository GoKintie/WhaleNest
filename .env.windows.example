# 首次启动会复制为 .env.windows。修改后重启生效。
WEB_BIND=127.0.0.1
WEB_PORT=3081
WEB_TOKEN=

# NapCat 的正向 OneBot WebSocket。使用远程 NapCat 时填它的实际地址。
ONEBOT_WS=ws://127.0.0.1:3001
ONEBOT_TOKEN=
# 远程 NapCat 需要能访问鲸鱼窝才可收取媒体。例如设为可信内网的管理地址。
PUBLIC_BASE=

OWNER_USERS=
ALLOW_USERS=
ALLOW_GROUPS=
ALLOW_ANYONE=false
AT_ONLY=true
PERMISSION_LEVEL=standard
LLM_PROVIDER=deepseek
BOT_NAME=小鲸鱼
# 模型 API Key 建议启动后在 WebUI 中设置并加密保存。
